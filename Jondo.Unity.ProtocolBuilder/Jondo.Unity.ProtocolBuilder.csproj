<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- La línea de comandos. Conserva carpeta, nombre y AssemblyName a propósito: la
         documentación cita trece órdenes que empiezan por «dotnet run» con este proyecto, y
         siguen valiendo letra por letra. Lo que se ha ido a Jondo.Unity.Reversing es el dominio;
         aquí sólo queda la fachada. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jondo.Unity.ProtocolBuilder</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <AssemblyName>protocolbuilder</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Program.cs lee FileDescriptorSet para el comando «volcar», que es el camino muerto del §3.1. -->
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jondo.Unity.Reversing\Jondo.Unity.Reversing.csproj" />
  </ItemGroup>

</Project>
