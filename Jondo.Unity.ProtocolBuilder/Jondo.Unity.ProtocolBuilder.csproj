<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The command line. It keeps folder, name and AssemblyName on purpose: the
         documentation cites thirteen commands starting with «dotnet run» with this project, and
         they still hold letter for letter. What went to Jondo.Unity.Reversing is the domain;
         only the façade is left here. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jondo.Unity.ProtocolBuilder</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <AssemblyName>protocolbuilder</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Program.cs reads FileDescriptorSet for the «volcar» command, which is the dead path of §3.1. -->
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jondo.Unity.Reversing\Jondo.Unity.Reversing.csproj" />
  </ItemGroup>

</Project>
