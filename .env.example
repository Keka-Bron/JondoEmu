# Copy to .env and adjust. Every value is optional.

# Host address the first server's ports are published on. 0.0.0.0 = every interface;
# 127.0.0.1 = this machine only (a launcher on the same host).
JONDO_BIND_IP=0.0.0.0

# Host address of the second server (docker compose --profile second up -d). It must differ from
# JONDO_BIND_IP: the ports are the same for every instance.
JONDO_BIND_IP_2=127.0.0.2

# Image tag, and whether the build skips the test suites (false runs them, slower).
JONDO_TAG=local
JONDO_SKIP_TESTS=true

TZ=UTC

# 1 turns off the game traffic log (logs/gameserver_traffic.log).
JONDO_SIN_REGISTRO_DE_TRAFICO=

# Minimum players for a guild raid; empty keeps the server's default.
JONDO_RAID_MIN_PLAYERS=
