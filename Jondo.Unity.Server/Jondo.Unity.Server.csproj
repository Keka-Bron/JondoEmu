<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The server's window: the log and the figures. It is ITS window, not the launcher's. -->
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <PropertyGroup>
    <!-- THE SERVER. A console, not a window: since the launcher is another executable, not a
         single line of WinForms is left in here. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Jondo Server</AssemblyName>
    <RootNamespace>Jondo.Unity.Launcher</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <ApplicationIcon>icono_servidor.ico</ApplicationIcon>
    <!-- A single file: the twelve dlls (Google.Protobuf, Thrift, Sqlite and company) are put inside
         the .exe, and the native e_sqlite3.dll too. It still depends on the .NET 10 runtime. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ApacheThrift" Version="0.23.0" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Tools" Version="2.81.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Microsoft.Data.Sqlite 10.0.9 drags in SQLitePCLRaw 2.1.11, and that carries a SQLite
         with CVE-2025-6965: high severity, range «<= 2.1.11». There is no newer stable Microsoft.Data.Sqlite
         that fixes it —11.0.0 is at preview.7—, so the package
         underneath is pinned here, which is what really brings the native library. When 11 stable comes out this
         can be removed, checking that NU1903 still does not appear. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protocol\GameProtocol.proto" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="world.db" />
    <Content Remove="auth.db" />
    <None Update="world.db" CopyToOutputDirectory="Never" />
    <None Update="auth.db" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jondo.Unity.Contract\Jondo.Unity.Contract.csproj" />
    <ProjectReference Include="..\Jondo.Unity.Protocol\Jondo.Unity.Protocol.csproj" />
    <ProjectReference Include="..\Jondo.Unity.World\Jondo.Unity.World.csproj" />
    <ProjectReference Include="..\Jondo.Unity.Contract.WinForms\Jondo.Unity.Contract.WinForms.csproj" />
  </ItemGroup>

  <!-- NOTHING GETS PUBLISHED WITH A RED TEST.

       The split between what runs at startup and what runs under `dotnet test` only holds if the
       tests actually run, and "somebody remembers" is not a mechanism. Publishing is the right
       gate: it is the one step between writing code and a player running it, and it is already
       the step that copies the executable to the root.

       Deliberately NOT on build. The inner loop stays fast, and a half-written change can still be
       compiled to see whether it type-checks.

       It runs as a separate `dotnet test` process rather than as a ProjectReference on purpose:
       Jondo.Unity.Tests references this project, so wiring it in would be a cycle. The MSBuild
       variables are cleared for the child process because a nested build inherits the parent's SDK
       paths and fails to resolve its own.

       In an emergency: dotnet publish -p:SkipTests=true. That is the whole escape hatch, and it
       leaves a trace in the command line rather than in a config file nobody reads. -->
  <Target Name="RunTestsBeforePublish" BeforeTargets="Publish" Condition="'$(SkipTests)' != 'true'">
    <Message Text="[Tests] Running Jondo.Unity.Tests before publishing..." Importance="high" />
    <Exec Command="dotnet test &quot;$(MSBuildProjectDirectory)\..\Jondo.Unity.Tests\Jondo.Unity.Tests.csproj&quot; --nologo --verbosity quiet" IgnoreStandardErrorWarningFormat="true" ContinueOnError="false" />
    <Message Text="[Tests] Green. Publishing." Importance="high" />
  </Target>

  <!-- Auto-deploy: only the .exe to the root. If some loose dll was left from an earlier
       publish, it is deleted so that the folder is not left half done. -->
  <Target Name="DeployServer" AfterTargets="Publish" Condition="'$(SkipRootDeploy)' != 'true'">
    <ItemGroup>
      <SueltasDeAntes Include="$(MSBuildProjectDirectory)\..\Google.Protobuf.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\Thrift.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\Microsoft.Data.Sqlite.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\SQLitePCLRaw.core.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\SQLitePCLRaw.provider.e_sqlite3.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\SQLitePCLRaw.batteries_v2.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\System.Net.Http.WinHttpHandler.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\e_sqlite3.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\Jondo.Unity.Core.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\Jondo.Unity.Core.pdb;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\Jondo.Unity.Protocol.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\Jondo.Unity.Protocol.pdb;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\Jondo.Unity.World.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\Jondo.Unity.World.pdb" />
    </ItemGroup>
    <Delete Files="@(SueltasDeAntes)" ContinueOnError="true" />
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(MSBuildProjectDirectory)\..\$(AssemblyName).exe" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true" />
    <Message Text="[Deploy] Servidor en la raiz." Importance="high" />
  </Target>

  <Target Name="ValidateOutputDirectory" BeforeTargets="BeforeBuild;BeforeRebuild">
    <PropertyGroup>
      <FullOutDir>$([System.IO.Path]::GetFullPath('$(OutDir)'))</FullOutDir>
      <FullRootDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\'))</FullRootDir>
    </PropertyGroup>
    <Error Condition="'$(FullOutDir)' == '$(FullRootDir)' Or '$(FullOutDir)' == '$(FullRootDir)\'" Text="[Build Error] Do not build directly into the emulator root directory." />
  </Target>

</Project>
