<?xml version="1.0" encoding="utf-8"?>
<!--
  Jondo's admin menu: the client's own one (Core.UILogic.Admin.AdminMenu). It is the first entry of
  the context menu of a character (right click on it); every "sendcommand" goes out as the staff
  console's line (F11) and the server's CommandHandler answers it, so each command= below is a
  command the server knows (a test reads this file and checks it: AdminMenuTests).
  JondoFix writes this file to <persistentDataPath>/Admin/menuadmin.xml when the client starts.
  Format and commands: docs/admin-menu.md.

  %p is the name of the character that was clicked (one's own when one clicks oneself); #item,
  #monster, #npc... open the client's selector window and are replaced by the choice.
  Commands about a player take the name first (jail %p); commands that change a character take it
  last (kamas 1000000 %p). Dangerous ones (ban, shutdown) sit behind a "Confirmer" submenu.
-->
<menu>
  <item type="menu" label="&lt;color=#ffcc33&gt;Jondo - Admin&lt;/color&gt;">
    <item type="static" label="Cible : %p"/>

    <!-- ═══ Modération ═══ -->
    <item type="menu" label="&lt;color=#7fd0ff&gt;Modération&lt;/color&gt;">
      <item type="static" label="Déplacements"/>
      <item type="sendcommand" label="Me téléporter vers %p" command="goto @%p" help="Va sur la carte et la case de %p"/>
      <item type="sendcommand" label="Amener %p vers moi" command="summon @%p" help="Téléporte %p sur ma case"/>
      <item type="separator"/>
      <item type="static" label="&lt;color=#d9d9d9&gt;Informations&lt;/color&gt;"/>
      <item type="sendcommand" label="Fiche de %p" command="whois @%p" help="Niveau, compte, rôle, carte, kamas, état"/>
      <item type="sendcommand" label="Où est %p ?" command="where @%p"/>
      <item type="separator"/>
      <item type="static" label="Prison"/>
      <item type="sendcommand" label="&lt;color=#ffb366&gt;Mettre %p en prison (10 min)&lt;/color&gt;" command="jail @%p" help="La prison des GM : 10 minutes, ni sortie ni autre canal que le général"/>
      <item type="sendcommand" label="Sortir %p de prison" command="unjail @%p"/>
      <item type="sendcommand" label="Qui est en prison ?" command="jailed"/>
      <item type="separator"/>
      <item type="menu" label="Rendre muet">
        <item type="static" label="Muet : %p"/>
        <item type="sendcommand" label="5 minutes" command="mute @%p 5m"/>
        <item type="sendcommand" label="30 minutes" command="mute @%p 30m"/>
        <item type="sendcommand" label="2 heures" command="mute @%p 2h"/>
        <item type="sendcommand" label="1 jour" command="mute @%p 1d"/>
        <item type="preparecommand" label="Durée libre..." command="mute @%p " help="mute &lt;joueur&gt; [durée] : 30, 30m, 12h, 7d"/>
        <item type="separator"/>
        <item type="sendcommand" label="Rendre la parole" command="unmute @%p"/>
      </item>
      <item type="menu" label="Avertir">
        <item type="static" label="Avertir %p"/>
        <item type="sendcommand" label="Insulte" command="warn @%p Les insultes sont interdites."/>
        <item type="sendcommand" label="Flood / spam" command="warn @%p Merci de cesser de répéter vos messages."/>
        <item type="sendcommand" label="Dernier avertissement" command="warn @%p Ceci est un dernier avertissement avant sanction."/>
        <item type="preparecommand" label="Message libre..." command="warn @%p " help="warn &lt;joueur&gt; &lt;message&gt;"/>
      </item>
      <item type="sendcommand" label="Expulser %p" command="kick @%p" help="Ferme sa connexion (il peut revenir)"/>
      <item type="separator"/>
      <item type="menu" label="&lt;color=#ff7070&gt;Bannir (administrateur)&lt;/color&gt;">
        <item type="static" label="Bannir le COMPTE de %p"/>
        <item type="menu" label="Confirmer : 1 jour">
          <item type="sendcommand" label="&lt;color=#ff7070&gt;Oui, bannir %p 1 jour&lt;/color&gt;" command="ban @%p 1d"/>
        </item>
        <item type="menu" label="Confirmer : 7 jours">
          <item type="sendcommand" label="&lt;color=#ff7070&gt;Oui, bannir %p 7 jours&lt;/color&gt;" command="ban @%p 7d"/>
        </item>
        <item type="menu" label="Confirmer : définitivement">
          <item type="sendcommand" label="&lt;color=#ff7070&gt;Oui, bannir %p pour toujours&lt;/color&gt;" command="ban @%p"/>
        </item>
        <item type="separator"/>
        <item type="preparecommand" label="Lever un bannissement..." command="unban " help="unban &lt;nom du personnage banni&gt;"/>
        <item type="sendcommand" label="Comptes bannis" command="bans"/>
      </item>
    </item>

    <!-- ═══ Personnage ═══ -->
    <item type="menu" label="&lt;color=#9be37f&gt;Personnage&lt;/color&gt;">
      <item type="static" label="Personnage : %p"/>
      <item type="menu" label="Kamas">
        <item type="sendcommand" label="+ 100 000" command="kamas 100000 @%p"/>
        <item type="sendcommand" label="+ 1 000 000" command="kamas 1000000 @%p"/>
        <item type="sendcommand" label="+ 100 000 000" command="kamas 100000000 @%p"/>
        <item type="sendcommand" label="- 1 000 000" command="kamas -1000000 @%p"/>
        <item type="preparecommand" label="Montant libre..." command="kamas " help="kamas &lt;montant&gt; [joueur]"/>
      </item>
      <item type="menu" label="Niveau">
        <item type="sendcommand" label="Niveau 1" command="level 1 @%p"/>
        <item type="sendcommand" label="Niveau 50" command="level 50 @%p"/>
        <item type="sendcommand" label="Niveau 100" command="level 100 @%p"/>
        <item type="sendcommand" label="Niveau 150" command="level 150 @%p"/>
        <item type="sendcommand" label="Niveau 200" command="level 200 @%p"/>
        <item type="preparecommand" label="Niveau libre..." command="level " help="level &lt;niveau&gt; [joueur]"/>
      </item>
      <item type="menu" label="Caractéristiques de base">
        <item type="preparecommand" label="Vitalité..." command="stats vit " help="stats vit &lt;valeur&gt; [joueur]"/>
        <item type="preparecommand" label="Sagesse..." command="stats sag "/>
        <item type="preparecommand" label="Force..." command="stats for "/>
        <item type="preparecommand" label="Intelligence..." command="stats int "/>
        <item type="preparecommand" label="Chance..." command="stats cha "/>
        <item type="preparecommand" label="Agilité..." command="stats agi "/>
      </item>
      <item type="menu" label="Vie et énergie">
        <item type="sendcommand" label="Soigner %p (toute la vie)" command="heal @%p"/>
        <item type="sendcommand" label="Énergie au maximum" command="energy 10000 @%p"/>
        <item type="sendcommand" label="Énergie à 1000" command="energy 1000 @%p"/>
        <item type="preparecommand" label="Énergie libre..." command="energy " help="energy [valeur] [joueur]"/>
      </item>
      <item type="menu" label="Apparence">
        <item type="sendcommand" label="Taille 50 %" command="size 50 @%p"/>
        <item type="sendcommand" label="Taille 100 % (normale)" command="size 100 @%p"/>
        <item type="sendcommand" label="Taille 200 %" command="size 200 @%p"/>
        <item type="preparecommand" label="Taille libre..." command="size " help="size &lt;pourcentage&gt; [joueur]"/>
      </item>
      <item type="menu" label="Métiers">
        <item type="sendcommand" label="Tous les métiers niveau 100" command="oficios 100 @%p"/>
        <item type="sendcommand" label="Tous les métiers niveau 200" command="oficios 200 @%p"/>
        <item type="preparecommand" label="Un métier..." command="oficio " help="oficio &lt;id du métier&gt; &lt;niveau&gt; [joueur]"/>
      </item>
      <item type="menu" label="Objets (administrateur)">
        <item type="sendcommand" label="Choisir un objet (catalogue)..." command="item #item @%p" help="Ouvre le sélecteur d'objets : id et quantité"/>
        <item type="preparecommand" label="Objet par id..." command="item " help="item &lt;id&gt; [quantité] [max|random] [joueur]"/>
        <item type="preparecommand" label="Panoplie..." command="itemset " help="itemset &lt;id de panoplie&gt; [joueur]"/>
        <item type="preparecommand" label="Ingrédients d'une recette..." command="receta " help="receta &lt;id de l'objet&gt; [fois] [joueur]"/>
        <item type="preparecommand" label="Cadeau (fenêtre des cadeaux)..." command="gift " help="gift &lt;id&gt; [quantité] [joueur] : le compte le récupère en jeu"/>
      </item>
      <item type="menu" label="Quêtes">
        <item type="static" label="Quêtes de %p"/>
        <item type="sendcommand" label="Mes quêtes en cours" command="quests"/>
        <item type="preparecommand" label="Démarrer une quête..." command="quest start " help="quest start &lt;id&gt; [joueur]"/>
        <item type="preparecommand" label="Terminer une quête..." command="quest finish " help="quest finish &lt;id&gt; [joueur]"/>
        <item type="preparecommand" label="Oublier une quête..." command="quest forget " help="quest forget &lt;id&gt; [joueur] : pour la rejouer"/>
      </item>
      <item type="menu" label="Contrôle des alliés (administrateur)">
        <item type="sendcommand" label="Un allié Iop" command="allycontrol 8"/>
        <item type="sendcommand" label="Deux alliés : Féca et Eniripsa" command="allycontrol 1 7"/>
        <item type="preparecommand" label="Classes..." command="allycontrol " help="allycontrol &lt;classe&gt; [classe...]"/>
      </item>
    </item>

    <!-- ═══ Monde ═══ -->
    <item type="menu" label="&lt;color=#ffb366&gt;Monde&lt;/color&gt;">
      <item type="menu" label="Téléportation">
        <item type="sendcommand" label="Astrub [4,-19]" command="teleport [4,-19]"/>
        <item type="sendcommand" label="Bonta [-26,-36]" command="teleport [-26,-36]"/>
        <item type="sendcommand" label="Brakmar [-26,35]" command="teleport [-26,35]"/>
        <item type="sendcommand" label="Village d'Amakna [-1,0]" command="teleport [-1,0]"/>
        <item type="sendcommand" label="Boutique (PNJ vendeurs)" command="shop"/>
        <item type="sendcommand" label="Carte suivante, mêmes coordonnées (administrateur)" command="relative" help="Intérieurs, maisons : fait défiler les cartes du même point"/>
        <item type="preparecommand" label="Coordonnées ou id de carte..." command="teleport " help="teleport [x,y] ou teleport &lt;id de carte&gt;"/>
      </item>
      <item type="menu" label="Monstres et PNJ">
        <item type="static" label="Sur ma case"/>
        <item type="sendcommand" label="Monstre (catalogue)..." command="spawn monster #monster" help="Ouvre le sélecteur de monstres"/>
        <item type="sendcommand" label="PNJ (catalogue)..." command="spawn npc #npc" help="Ouvre le sélecteur de PNJ"/>
        <item type="preparecommand" label="Groupe de monstres par id..." command="spawn monster " help="spawn monster &lt;id&gt;[:grade] [&lt;id&gt;[:grade]...] : jusqu'à huit"/>
        <item type="separator"/>
        <item type="sendcommand" label="Ce qu'il y a sur la carte" command="mapinfo" help="Liste les ids à retirer"/>
        <item type="preparecommand" label="Retirer un PNJ..." command="remove npc " help="remove npc &lt;id&gt;"/>
        <item type="preparecommand" label="Retirer un groupe de monstres..." command="remove group " help="remove group &lt;id&gt;"/>
      </item>
      <item type="menu" label="Quêtes (tests)">
        <item type="sendcommand" label="Quêtes en cours" command="quests"/>
        <item type="preparecommand" label="Démarrer..." command="quest start "/>
        <item type="preparecommand" label="Terminer..." command="quest finish "/>
        <item type="preparecommand" label="Oublier..." command="quest forget "/>
        <item type="separator"/>
        <item type="sendcommand" label="Recharger le contenu (administrateur)" command="reload" help="Relit les fichiers de contenu sans redémarrer"/>
      </item>
    </item>

    <!-- ═══ Informations ═══ -->
    <item type="menu" label="Informations">
      <item type="sendcommand" label="Qui suis-je ?" command="whoami"/>
      <item type="sendcommand" label="Où suis-je ? (carte, case)" command="where"/>
      <item type="sendcommand" label="Cette carte" command="mapinfo"/>
      <item type="sendcommand" label="Joueurs connectés" command="who"/>
      <item type="sendcommand" label="Version du serveur" command="version"/>
      <item type="sendcommand" label="Fiche de %p" command="whois @%p"/>
      <item type="sendcommand" label="Aide de la console (toutes les commandes)" command="help"/>
    </item>

    <!-- ═══ Serveur (administrateur) ═══ -->
    <item type="menu" label="&lt;color=#ff7070&gt;Serveur (administrateur)&lt;/color&gt;">
      <item type="menu" label="Annonces">
        <item type="preparecommand" label="Annonce libre..." command="announce " help="announce &lt;texte&gt; : un message à tous les connectés"/>
        <item type="sendcommand" label="Maintenance imminente" command="announce Une maintenance va bientôt avoir lieu."/>
        <item type="sendcommand" label="Retour du serveur" command="announce Le serveur est de nouveau disponible, merci de votre patience."/>
      </item>
      <item type="sendcommand" label="Sauvegarder les personnages" command="save"/>
      <item type="sendcommand" label="Recharger le contenu" command="reload" help="PNJ, quêtes, interactifs, boutiques : sans redémarrer"/>
      <item type="separator"/>
      <item type="menu" label="&lt;color=#ff7070&gt;Arrêter le serveur&lt;/color&gt;">
        <item type="static" label="&lt;color=#ff7070&gt;ATTENTION&lt;/color&gt;"/>
        <item type="menu" label="Confirmer : dans 5 minutes">
          <item type="sendcommand" label="&lt;color=#ff7070&gt;Oui, arrêt dans 5 minutes&lt;/color&gt;" command="shutdown 5"/>
        </item>
        <item type="menu" label="Confirmer : maintenant">
          <item type="sendcommand" label="&lt;color=#ff7070&gt;Oui, arrêter MAINTENANT&lt;/color&gt;" command="shutdown"/>
        </item>
        <item type="sendcommand" label="Annuler l'arrêt programmé" command="shutdown cancel"/>
      </item>
    </item>

    <item type="separator"/>
    <item type="loadxml" label="Recharger ce menu" help="Relit menuadmin.xml sans redémarrer le client"/>
  </item>
</menu>
