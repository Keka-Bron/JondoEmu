<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The deobfuscator's face. A workshop tool, not something handed out: it stays in
         bin\ and is not copied to the root like the server and the launcher, which people do open. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Jondo Desofuscador</AssemblyName>
    <RootNamespace>Jondo.Unity.Deobfuscator</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The look comes from the contract, as in the other two executables. The stages come from
         Reversing, called in process: that way progress is seen while they run, instead of launching an
         .exe and reading its output. The console (protocolbuilder) uses exactly the same ones. -->
    <ProjectReference Include="..\Jondo.Unity.Contract\Jondo.Unity.Contract.csproj" />
    <ProjectReference Include="..\Jondo.Unity.Reversing\Jondo.Unity.Reversing.csproj" />
    <ProjectReference Include="..\Jondo.Unity.Contract.WinForms\Jondo.Unity.Contract.WinForms.csproj" />
  </ItemGroup>

</Project>
