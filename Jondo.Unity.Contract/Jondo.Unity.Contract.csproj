<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <!-- The little the server and the launcher have to know about each other. No database,
         no protocol, no windows: file paths, portable preference encryption, the control channel's
         contract, the texts and the palette. It travels in the desktop executables, so the less it has,
         the better.

         The desktop applications use Avalonia; this contract stays independent of the UI toolkit.
         LauncherPalette stores colours as numbers, without depending on what they are painted with. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <ProjectReference Include="..\Jondo.Unity.Core\Jondo.Unity.Core.csproj" />
  </ItemGroup>

</Project>
