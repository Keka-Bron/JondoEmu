<Project>

  <PropertyGroup>
    <!--
      Who made each executable, in its Windows file properties (Details tab). Left out, the SDK
      put the assembly's own name as company and product and no copyright at all, which is how an
      anonymous binary looks to an antivirus's heuristics. The version comes from the release
      (-p:Version in release.yml).
    -->
    <Company>Jondo</Company>
    <Product>Jondo Emulator</Product>
    <Authors>Jondo contributors</Authors>
    <Copyright>Copyright (c) Jondo contributors</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JondoProtocolTarget)' == '3.8.1.2'">
    <DefineConstants>$(DefineConstants);JONDO_PROTOCOL_3_8_1_2</DefineConstants>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$(MSBuildThisFileDirectory)host-artifacts</ArtifactsPath>
    <!-- Keep both obj and bin isolated, even when both builds share an artifacts root. -->
    <ArtifactsProjectName>$(MSBuildProjectName).protocol-$(JondoProtocolTarget)</ArtifactsProjectName>
  </PropertyGroup>

</Project>
