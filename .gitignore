# Lo que se publica es lo justo para ejecutar el emulador sin recompilarlo: el .exe de la raíz,
# datos/ con lo que lee, launcher_assets/, docs/ y el código fuente. Todo lo demás fuera.

# ─── Compilación ────────────────────────────────────────────────────────────
[Bb]in/
[Oo]bj/
publish/
runtimes/
*.pdb
*.deps.json
*.runtimeconfig.json
# Las dll van dentro del .exe de un solo fichero; ninguna suelta.
*.dll

# ─── Bases de datos ─────────────────────────────────────────────────────────
# world.db son 240 MB: se distribuye comprimida en datos/world.zip y el emulador la extrae sola
# la primera vez. auth.db la crea él con su cuenta de prueba.
bases/
*.db
*.db-shm
*.db-wal

# ─── Datos extraídos del cliente ────────────────────────────────────────────
# 436 MB de volcado en crudo. No hace falta para ejecutar: lo que el emulador lee ya está en
# datos/, y lo genera tools/ a partir de esta carpeta.
dofus3_data/
Dofus3 Defuscated Data/
DofusClient/

# ─── Herramientas ───────────────────────────────────────────────────────────
# Los scripts de Python generan los json de datos/ y auditan el tráfico. No se necesitan para
# ejecutar el emulador.
tools/
*.py
__pycache__/

# ─── Registros y capturas ───────────────────────────────────────────────────
# Nunca. Llevan nombres de cuentas reales.
logs/
*.log
*.csv
*.pcapng
*.hex

# ─── Datos que el emulador no lee ───────────────────────────────────────────
# Están en el disco por referencia, pero Paths no los resuelve.
datos/world_entering_3_6_10_10.bin
datos/characteristics.json
datos/dofus3_mappings.json
datos/effects.json
datos/map_neighbours.json

# ─── Restos de versiones anteriores ─────────────────────────────────────────
out.txt
mock_server.db
*_old.cs
scratch_*

# ─── Entornos de desarrollo ─────────────────────────────────────────────────
.vs/
.idea/
.vscode/
*.user
*.suo
