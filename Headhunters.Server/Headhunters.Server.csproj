<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <InternalsVisibleTo Include="Jondo.Unity.Module.Tests" />
    <ProjectReference Include="..\Jondo.Unity.Contract\Jondo.Unity.Contract.csproj" Private="false" />
  </ItemGroup>

  <Target Name="StageServerMod" AfterTargets="Build" Condition="'$(StageServerMod)' == 'true'">
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)/manifest.json;$(MSBuildProjectDirectory)/../Headhunters/Headhunters.dll"
          DestinationFolder="$(HeadhuntersPackageDirectory)" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <HeadhuntersPackageDirectory Condition="'$(HeadhuntersPackageDirectory)' == ''">$(MSBuildProjectDirectory)/../mods/headhunters</HeadhuntersPackageDirectory>
  </PropertyGroup>
</Project>
