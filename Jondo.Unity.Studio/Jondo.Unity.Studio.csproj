<Project Sdk="Microsoft.NET.Sdk">

  <!-- THE WORLD EDITOR.

       A third executable next to the launcher and the server. It works on its own: it opens
       content/ and the databases, edits and saves, with nothing running. Talking to a live server
       comes later, and when it does it will be a thin channel that only says "reload this domain".

       Avalonia rather than a local web UI for one reason above the rest: there is no serialisation
       boundary. It references Jondo.Unity.World and Jondo.Unity.Contract as projects and uses
       MapGeometry, Fighter and SpellEffect directly. Seven of the eight planned modules manipulate
       domain objects and only one paints pixels, so an HTTP layer would be a lot of machinery for
       one module out of eight. See docs/world-editor.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jondo Studio</AssemblyName>
    <RootNamespace>Jondo.Unity.Studio</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- The same egg the launcher wears, in bronze. Three executables of one family, told apart
         at a glance in a taskbar: green the launcher, and this one bronze. -->
    <ApplicationIcon>icon_studio.ico</ApplicationIcon>

    <!-- Published as one file, like the server, so the root stays clean. The RuntimeIdentifier
         only decides what `dotnet publish` produces here; the project still targets plain net10.0,
         so publishing it for macOS or Linux is a flag away and nothing in the code cares. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <!-- Avalonia drags in Tmds.DBus.Protocol 0.20.0, which carries GHSA-xrw6-gwf8-vvr9 (high
         severity). It is Linux's DBus piece and it is not used here, but it travels in the package all the same, so
         the fixed version is pinned (0.21.3: the 0.21.2 there was is still flagged, and from 0.22 onwards too). The same remedy as with SQLitePCLRaw in the server. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />

    <!-- To read bases/paquetes.db, which is where the server writes what it could not handle.
         Read only, and it is the server's table, not the editor's: the conclusions a person draws
         from it go to content/packets/shapes.json, which git can review. Same versions as the
         server so the two never end up carrying two native SQLite builds. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />

    <!-- To read the client's own bundles: the monsters' icons are in
         Picto/Monsters/monster_assets_1x.bundle, 2,395 textures of 64x64. They are read from there instead of
         being copied to datos/: the client already takes up what it takes up, and a copy of ours would go stale
         the day of the next patch without anyone noticing. The second is needed because the
         textures are in BC7 and have to be decompressed. -->
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="AssetsTools.NET.Texture" Version="3.0.2" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jondo.Unity.Core\Jondo.Unity.Core.csproj" />
    <ProjectReference Include="..\Jondo.Unity.World\Jondo.Unity.World.csproj" />
    <ProjectReference Include="..\Jondo.Unity.Sprites\Jondo.Unity.Sprites.csproj" />
  </ItemGroup>

  <!-- Every section is built once, off screen, against the real data on this machine, and the
       copy to the root does not happen if any of them threw.

       The logic behind the sections is covered by Jondo.Unity.Tests. What no test there reaches is
       the construction of the controls themselves, and that is not a theoretical gap: a malformed
       column specification or a null in a template throws at construction, and until this target
       existed the only way it showed up was somebody clicking that section. Same escape hatch as
       the server's test gate, -p:SkipTests=true, which leaves its trace on the command line
       rather than in a config file nobody reads. -->
  <Target Name="StudioSelfTest" AfterTargets="Publish" Condition="'$(SkipTests)' != 'true'">
    <Message Text="[Studio] Construyendo todas las secciones contra los datos de verdad..." Importance="high" />
    <Exec Command="&quot;$(PublishDir)$(AssemblyName).exe&quot; --selftest" IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <!-- Auto-deploy: to the root, next to the launcher and the server. Same reasoning as the
       server's own target — what a person double-clicks lives in the root, and everything else
       stays inside a folder. -->
  <Target Name="DeployStudio" AfterTargets="Publish" DependsOnTargets="StudioSelfTest" Condition="'$(SkipRootDeploy)' != 'true'">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(MSBuildProjectDirectory)\..\$(AssemblyName).exe" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true" />
    <Message Text="[Deploy] Studio en la raiz." Importance="high" />
  </Target>

  <Target Name="ValidateOutputDirectory" BeforeTargets="BeforeBuild;BeforeRebuild">
    <PropertyGroup>
      <FullOutDir>$([System.IO.Path]::GetFullPath('$(OutDir)'))</FullOutDir>
      <FullRootDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\'))</FullRootDir>
    </PropertyGroup>
    <Error Condition="'$(FullOutDir)' == '$(FullRootDir)' Or '$(FullOutDir)' == '$(FullRootDir)\'" Text="[Build Error] Do not build directly into the emulator root directory." />
  </Target>

</Project>
