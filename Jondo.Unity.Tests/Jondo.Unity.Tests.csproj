<Project Sdk="Microsoft.NET.Sdk">

  <!-- Targets net10.0-windows because it references Jondo.Unity.Server, which is a WinForms
       executable: the server owns its own log window. Nothing here touches the UI. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jondo.Unity.Launcher\Jondo.Unity.Launcher.csproj" />
    <ProjectReference Include="..\Jondo.Unity.World\Jondo.Unity.World.csproj" />
    <ProjectReference Include="..\Jondo.Unity.Server\Jondo.Unity.Server.csproj" />
    <!-- The editor, for the parts of it that are not user interface. The frame decoder and
         the packet observations are ordinary logic that happens to live in a GUI project,
         and they are exactly the kind of code that is wrong in ways looking at a window
         does not reveal: a zigzagged integer or a packed array shows a plausible number
         either way. Nothing here constructs a control. -->
    <ProjectReference Include="..\Jondo.Unity.Studio\Jondo.Unity.Studio.csproj" />
  </ItemGroup>

</Project>
