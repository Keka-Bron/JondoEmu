<Project Sdk="Microsoft.NET.Sdk">

  <!-- The debugging tools an AI agent drives the emulator with, over MCP (stdio): the server and
       its test routes, a slot played without the client, and the real client's window. See
       docs/mcp.md. A developer's tool: it is not published with the emulator. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Jondo.Unity.Mcp</RootNamespace>
    <AssemblyTitle>Jondo MCP</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where the emulator's data is and where the Dofus client is installed, found as the launcher finds them. -->
    <ProjectReference Include="..\Jondo.Unity.Core\Jondo.Unity.Core.csproj" />
    <!-- The control API's port and route prefix. -->
    <ProjectReference Include="..\Jondo.Unity.Contract\Jondo.Unity.Contract.csproj" />
  </ItemGroup>

</Project>
