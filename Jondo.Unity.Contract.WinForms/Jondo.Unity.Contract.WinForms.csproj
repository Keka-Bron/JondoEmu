<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The Windows Forms half of what is shared: the hand-painted controls the
         server and the deobfuscator use. They were inside Jondo.Unity.Contract, and that forced
         Contract to be net10.0-windows with Windows Forms inside; since EVERYONE references
         Contract, Windows Forms also travelled to the launcher and to Studio, which are Avalonia.

         With it split off, Contract is pure net10.0 again and only whoever really uses Windows Forms
         drags it along. The palette has not stayed here: it lives in Contract, in
         LauncherPalette, so that both looks -this one and Avalonia's- come from the same
         numbers and not from a hand copy. -->
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jondo.Unity.Contract\Jondo.Unity.Contract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
