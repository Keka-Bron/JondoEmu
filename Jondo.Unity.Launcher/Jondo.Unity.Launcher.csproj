<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="$(RuntimeIdentifier.StartsWith('win-')) Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')">WinExe</OutputType>
    <!-- One Avalonia desktop on both platforms; native client integration is selected at runtime. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jondo Emulator Launcher</AssemblyName>
    <RootNamespace>Jondo.Unity.Launcher</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <ApplicationIcon>..\Jondo.Unity.Server\icon.ico</ApplicationIcon>
    <!-- It runs as the player, never as administrator, on Windows 10 and 11, aware of each
         screen's scale: said in its manifest, as Studio's. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Jondo Emulator Launcher</AssemblyTitle>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- THIS is the one handed out to the players. It references the contract and NOTHING ELSE: no
         database, no maps, no protocol handlers, no effects catalogue. A single file,
         as before, so that whoever downloads it sees an .exe and not a folder of dlls.
         It is also the installer, run on machines with no .NET yet: so it carries its own
         runtime, compressed inside the file, and installs the shared one the server and
         MelonLoader need. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <!-- Only the published file carries the runtime: built as a reference (the tests), it is a plain assembly. -->
    <SelfContained Condition="'$(_IsPublishing)' == 'true'">true</SelfContained>
    <SelfContained Condition="'$(_IsPublishing)' != 'true'">false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile Condition="'$(_IsPublishing)' == 'true'">true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The GitHub repository updates are looked for in until the player names another; the
         release workflow passes its own. -->
    <JondoRepository Condition="'$(JondoRepository)' == ''">Keka-Bron/JondoEmu</JondoRepository>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <!-- Avalonia.Desktop drags in Tmds.DBus.Protocol 0.20.0 for its Linux part, and that version
         has a high-severity security advisory (GHSA-xrw6-gwf8-vvr9). It is raised by hand, which is
         the same Studio already did for the same reason. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <!-- The client comes as a 7z; the emulator's release as a zip. -->
    <PackageReference Include="SharpCompress" Version="0.50.7" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="JondoRepository" Value="$(JondoRepository)" />
    <!-- The background and the theme inside the executable: the setup is downloaded alone. -->
    <EmbeddedResource Include="../launcher_assets/bg.jpg" LogicalName="JondoAssets.bg.jpg" />
    <EmbeddedResource Include="../launcher_assets/theme.mp3" LogicalName="JondoAssets.theme.mp3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jondo.Unity.Contract\Jondo.Unity.Contract.csproj" />
    <ProjectReference Include="..\Jondo.Unity.Sprites\Jondo.Unity.Sprites.csproj" />
    <!-- The Cytrus manifest reader, for the optional HD/4K scenery packs. No dependencies. -->
    <ProjectReference Include="..\Jondo.Unity.Cytrus\Jondo.Unity.Cytrus.csproj" />
  </ItemGroup>

  <Target Name="DesplegarLauncher" AfterTargets="Publish" Condition="'$(SkipRootDeploy)' != 'true'">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName)$(_NativeExecutableExtension)" DestinationFiles="$(MSBuildProjectDirectory)/../$(AssemblyName)$(_NativeExecutableExtension)" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true" />
    <Message Text="[Deploy] Launcher en la raiz." Importance="high" />
  </Target>

</Project>
