<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Jondo Emulator Launcher</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- The launcher interface is a native WinForms window (it used to be a web page). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The controls in the UI folder are built and configured from code, never from the Visual
         Studio designer, so they do not need serialization attributes (WFO1000). -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);WFO1000</WarningsNotAsErrors>
    <!-- Un solo fichero. La raíz del emulador no debe tener ficheros sueltos: quien se lo baje
         tiene que ver el .exe y carpetas, sin dudar de qué abrir. Al publicar en un único fichero
         las doce dll (Google.Protobuf, Thrift, Sqlite y compañía) se meten dentro del .exe, y la
         nativa e_sqlite3.dll también. Sigue siendo dependiente del framework: hace falta el
         runtime de .NET 10 instalado, igual que antes. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ApacheThrift" Version="0.23.0" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Tools" Version="2.81.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="System.Text.Json" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protocol\GameProtocol.proto" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms adds System.Windows.Forms and System.Drawing to the implicit usings. We do not
         want them global: the rest of the emulator uses names such as Timer, Point or Message
         that would clash. The files in the UI folder declare their own usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="world.db" />
    <Content Remove="auth.db" />
    <None Update="world.db" CopyToOutputDirectory="Never" />
    <None Update="auth.db" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jondo.Unity.Protocol\Jondo.Unity.Protocol.csproj" />
    <ProjectReference Include="..\Jondo.Unity.World\Jondo.Unity.World.csproj" />
  </ItemGroup>

  <!-- Auto-deploy: al publicar en un solo fichero lo único que hay que llevar a la raíz es el
       .exe. Las dll de antes se quedan dentro; si quedaba alguna suelta de una publicación
       anterior, se borra para que la carpeta no se quede a medias. -->
  <Target Name="DeployLauncher" AfterTargets="Publish">
    <ItemGroup>
      <SueltasDeAntes Include="$(MSBuildProjectDirectory)\..\Google.Protobuf.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\Thrift.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\Microsoft.Data.Sqlite.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\SQLitePCLRaw.core.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\SQLitePCLRaw.provider.e_sqlite3.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\SQLitePCLRaw.batteries_v2.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\System.Net.Http.WinHttpHandler.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\e_sqlite3.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\Jondo.Unity.Core.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\Jondo.Unity.Core.pdb;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\Jondo.Unity.Protocol.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\Jondo.Unity.Protocol.pdb;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\Jondo.Unity.World.dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\Jondo.Unity.World.pdb;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\$(AssemblyName).dll;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\$(AssemblyName).pdb;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\$(AssemblyName).deps.json;&#xD;&#xA;                               $(MSBuildProjectDirectory)\..\$(AssemblyName).runtimeconfig.json" />
    </ItemGroup>
    <Delete Files="@(SueltasDeAntes)" ContinueOnError="true" />
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(MSBuildProjectDirectory)\..\Jondo Emulator Launcher.exe" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true" />
    <Message Text="[Deploy] Solo el .exe en la raíz; las dll van dentro." Importance="high" />
  </Target>

  <!-- Prevent accidental pollution of the root directory by compiling/publishing directly to it -->
  <Target Name="ValidatePublishDirectory" BeforeTargets="PrepareForPublish;BeforePublish">
    <PropertyGroup>
      <FullPublishDir>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</FullPublishDir>
      <FullRootDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\'))</FullRootDir>
    </PropertyGroup>
    <Error Condition="'$(FullPublishDir)' == '$(FullRootDir)' Or '$(FullPublishDir)' == '$(FullRootDir)\'" Text="[Build Error] Do not publish directly into the emulator root directory. That pollutes the folder with hundreds of .NET files. Publish without pointing the output at the root and the selective deploy will copy only what is needed." />
  </Target>

  <Target Name="ValidateOutputDirectory" BeforeTargets="BeforeBuild;BeforeRebuild">
    <PropertyGroup>
      <FullOutDir>$([System.IO.Path]::GetFullPath('$(OutDir)'))</FullOutDir>
      <FullRootDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\'))</FullRootDir>
    </PropertyGroup>
    <Error Condition="'$(FullOutDir)' == '$(FullRootDir)' Or '$(FullOutDir)' == '$(FullRootDir)\'" Text="[Build Error] Do not build directly into the emulator root directory. That pollutes the folder with hundreds of .NET files. Build to the default path (bin/) and publish will take care of the clean deploy." />
  </Target>

	<ItemGroup>
		<None Include="Data\breed_dump.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
