<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- It is no longer net10.0-windows. The launcher was Windows Forms and is now Avalonia, like
         Studio, so there is nothing tying it to the Windows desktop except the music, which goes
         behind an operating system check. It is still published for win-x64 because
         that is where the players are, not because the code cannot do anything else. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jondo Emulator Launcher</AssemblyName>
    <RootNamespace>Jondo.Unity.Launcher</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <ApplicationIcon>..\Jondo.Unity.Server\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- THIS is the one handed out to the players. It references the contract and NOTHING ELSE: no
         database, no maps, no protocol handlers, no effects catalogue. A single file,
         as before, so that whoever downloads it sees an .exe and not a folder of dlls. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- Avalonia.Desktop drags in Tmds.DBus.Protocol 0.20.0 for its Linux part, and that version
         has a high-severity security advisory (GHSA-xrw6-gwf8-vvr9). It is raised by hand, which is
         the same Studio already did for the same reason. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jondo.Unity.Contract\Jondo.Unity.Contract.csproj" />
    <ProjectReference Include="..\Jondo.Unity.Sprites\Jondo.Unity.Sprites.csproj" />
    <!-- The Cytrus manifest reader, for the optional HD/4K scenery packs. No dependencies. -->
    <ProjectReference Include="..\Jondo.Unity.Cytrus\Jondo.Unity.Cytrus.csproj" />
  </ItemGroup>

  <Target Name="DesplegarLauncher" AfterTargets="Publish" Condition="'$(SkipRootDeploy)' != 'true'">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(MSBuildProjectDirectory)\..\Jondo Emulator Launcher.exe" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true" />
    <Message Text="[Deploy] Launcher en la raiz." Importance="high" />
  </Target>

</Project>
